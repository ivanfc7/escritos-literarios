---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import '../styles/publicacion.css';

type Props = CollectionEntry<'cuento'>['data'];

const { title, description, pubDate, updatedDate, pubIn, pubLink, heroImage } = Astro.props;

const pathname = Astro.url.pathname;
const esPoema = pathname.includes('/poema');
const textoRegreso = esPoema ? 'Ver más poemas' : 'Ver más cuentos';
const linkRegreso = esPoema ? '/poema' : '/cuento';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="lectura-container">
			<article class="articulo-literario">
				<div class="hero-image">
					{heroImage && <Image src={heroImage} alt={`Ilustracion para ${title}`} class="lectura-hero-img"/>}
				</div>
				<div class="prose">
					<header class="lectura-header">
						{description && <p class="lectura-sinopsis">{description}</p>}
						<div class="meta-fecha">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="fecha-actualizacion">
									• (Actualizado el <FormattedDate date={updatedDate} />)
								</span>
							)}
						</div>
						<hr class="divisor-lectura" />
					</header>
					<h2 class="lectura-titulo">{title}</h2> <br>
					<div class={esPoema? "contenido-markdown-poema":"contenido-markdown-cuento"}>
						<slot />
					</div>
					{pubIn && pubLink && (
						<div class="nota-publicacion">
							<p>
								Encuentra la publicación original en 
								<a href={pubLink} target="_blank" rel="noopener noreferrer">{pubIn}</a>.
							</p>
						</div>
					)}
					<nav class="navegacion-retorno">
						<a href={linkRegreso} class="enlace-retorno">
							<span class="flecha">&larr;</span> {textoRegreso}
						</a>
						<div class="acciones-publicacion">
							<button class="btn-copiar-link" onclick="copiarEnlace(this, window.location.href)">
								<i class="fa-regular fa-share-from-square"></i>
								<span>Compartir</span>
							</button>
						</div>
					</nav>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
<script is:inline>
	function copiarEnlace(btn, url) {
	  navigator.clipboard.writeText(url).then(() => {
		const texto = btn.querySelector('span');
		const textoOriginal = texto.textContent;
		
		btn.classList.add('copiado');
		texto.textContent = '¡Enlace copiado!';
		
		setTimeout(() => {
		  btn.classList.remove('copiado');
		  texto.textContent = textoOriginal;
		}, 2000);
	  });
	}
  </script>